{
  "name": "risk-qa-decision-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "validate:data": "node scripts/validate-registry.mjs data/repos/index.json",
    "test:contract": "node --test tests/status-contract.test.mjs tests/status-cli.test.mjs tests/sync-status.test.mjs tests/registry.test.mjs tests/pages-artifact.test.mjs tests/template-contract.test.mjs tests/decision-policy.test.mjs tests/release-evidence.test.mjs tests/release-files.test.mjs",
    "test:playbooks": "node --test tests/playbooks/playbook-contract.test.mjs && node tests/playbooks/validate-fixture.mjs tests/playbooks/fixtures",
    "test:rendered": "npm run build && node --test tests/rendered-html.test.mjs",
    "test": "npm run validate:archive && npm run test:contract && npm run test:playbooks && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "predev": "node scripts/prepare-decision-data.mjs",
    "prebuild": "node scripts/prepare-decision-data.mjs",
    "validate:archive": "node scripts/validate-registry.mjs data/repos/index.json --historical",
    "gate:release": "node scripts/validate-registry.mjs data/repos/index.json --release",
    "review:release": "node scripts/review-release.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
