{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanyoii/RiskQADemoSite/schema/risks.schema.json",
  "title": "Public risk catalog",
  "description": "Severity, owner, and handling for the public risk page. relatedExitCriterion is EC-1 through EC-4, or null when no exit criterion applies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks"],
  "properties": {
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "severity", "title", "owner", "handling", "dueAt", "relatedExitCriterion", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["S1", "S2", "S3"] },
          "title": { "$ref": "#/$defs/text" },
          "owner": { "type": "string", "minLength": 1 },
          "handling": { "$ref": "#/$defs/text" },
          "dueAt": { "type": ["string", "null"] },
          "relatedExitCriterion": {
            "anyOf": [
              { "enum": ["EC-1", "EC-2", "EC-3", "EC-4"] },
              { "type": "null" }
            ]
          },
          "source": { "type": "string", "minLength": 1 },
          "synthetic": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
